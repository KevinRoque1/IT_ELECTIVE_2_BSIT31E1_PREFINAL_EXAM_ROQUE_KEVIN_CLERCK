@{
    ViewData["Title"] = "Prefinal Exam - Flashcard Quiz";
}

<div class="quiz-header">
    <h1>IT Elective 2 - Prefinal Exam</h1>
    <p>Click a card to flip it and reveal the answer.</p>
</div>

<div class="card-grid" id="cardGrid"></div>

<style>
    .quiz-header { text-align: center; margin: 20px 0; }
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        padding: 20px;
    }
    .flip-card {
        background-color: transparent;
        width: 100%;
        height: 220px;
        perspective: 1000px;
        cursor: pointer;
    }
    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.6s;
        transform-style: preserve-3d;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        border-radius: 12px;
    }
    .flip-card.flipped .flip-card-inner {
        transform: rotateY(180deg);
    }
    .flip-card-front, .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        box-sizing: border-box;
        font-size: 15px;
    }
    .flip-card-front {
        background: linear-gradient(135deg, #4b6cb7, #182848);
        color: white;
    }
    .flip-card-back {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: white;
        transform: rotateY(180deg);
        font-weight: bold;
    }
    .q-number {
        position: absolute;
        top: 8px;
        left: 12px;
        font-size: 12px;
        opacity: 0.8;
    }
</style>

<script>
    const questions = [
        { q: "What is the main problem solved by using a database instead of an in-memory collection?", a: "It allows data to persist after the application stops" },
        { q: "Which approach is being used when an existing database is used to generate EF Core entity classes?", a: "Database-First" ,
        { q: "What is the primary purpose of Entity Framework Core?", a: "C. To map objects in code to relational database data" }
    ];

    const grid = document.getElementById("cardGrid");
    questions.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "flip-card";
        card.innerHTML = `
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <span class="q-number">Q${index + 1}</span>
                    <div>${item.q}</div>
                </div>
                <div class="flip-card-back">
                    <div>${item.a}</div>
                </div>
            </div>
        `;
        card.addEventListener("click", () => card.classList.toggle("flipped"));
        grid.appendChild(card);
    });
</script>