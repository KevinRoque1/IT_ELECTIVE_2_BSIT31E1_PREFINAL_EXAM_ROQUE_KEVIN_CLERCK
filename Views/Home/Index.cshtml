@{
    ViewData["Title"] = "Prefinal Exam - Flashcard Quiz";
}

<div style="min-height:100vh; background:linear-gradient(160deg, #0f1b33, #16223f 60%, #0f1b33); margin:0; padding:40px 20px; font-family:sans-serif;">

    <div style="max-width:560px; margin:0 auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
            <div style="font-size:22px; font-weight:600; color:#eef1f8;">Prefinal Exam Quiz</div>
            <div id="counter" style="font-size:13px; color:#b7c2dd; background:rgba(255,255,255,0.08); padding:6px 14px; border-radius:999px; border:1px solid rgba(255,255,255,0.12);">1 / 20</div>
        </div>

        <div style="position:relative; height:440px;" id="stage"></div>

        <div style="display:flex; justify-content:center; align-items:center; gap:28px; margin-top:28px;">
            <button id="prevBtn" style="width:50px; height:50px; border-radius:50%; border:1px solid rgba(255,255,255,0.18); background:rgba(255,255,255,0.06); color:#eef1f8; cursor:pointer; font-size:20px;">&#8592;</button>
            <button id="flipBtn" style="padding:0 26px; height:46px; border-radius:10px; border:1px solid rgba(255,255,255,0.18); background:rgba(255,255,255,0.06); color:#eef1f8; cursor:pointer; font-size:14px;">&#8635; Flip card</button>
            <button id="nextBtn" style="width:50px; height:50px; border-radius:50%; border:1px solid rgba(255,255,255,0.18); background:rgba(255,255,255,0.06); color:#eef1f8; cursor:pointer; font-size:20px;">&#8594;</button>
        </div>
    </div>
</div>

<style>
    .stack-card {
        position: absolute;
        inset: 0;
        border-radius: 20px;
        box-shadow: 0 16px 32px rgba(0,0,0,0.45);
    }

    #prevBtn:hover, #nextBtn:hover, #flipBtn:hover {
        background: rgba(255,255,255,0.14) !important;
    }
</style>

<script>
    const data = [
        ["What is the main problem solved by using a database instead of an in-memory collection?", "It allows data to persist after the application stops"],
        ["Which approach is being used when an existing database is used to generate EF Core entity classes?", "Database-First"],
        ["What is the primary purpose of Entity Framework Core?", "To map objects in code to relational database data"],
        ["Which EF Core component is primarily responsible for communicating with the database?", "DbContext"],
        ["What does the scaffold command primarily do?", "Generates EF Core models and a DbContext from an existing database"],
        ["Where is a database connection string commonly stored in an ASP.NET Core MVC application?", "appsettings.json"],
        ["A Student belongs to exactly one Section, while a Section can contain many students. What type of relationship is this?", "One-to-Many"],
        ["In the Student model, what is 'SectionId'?", "Foreign key referencing Section"],
        ["What is the purpose of a navigation property such as 'public Section Section { get; set; }'?", "It represents a relationship to another entity"],
        ["What does '.Include()' generally allow EF Core to do?", "Load related Section data together with Students"],
        ["Why might a ViewModel be used when displaying Student and Section information?", "To combine or shape the data specifically needed by the view"],
        ["What is the main benefit of 'Include(s => s.Section)' in a query?", "It loads the related Section navigation property"],
        ["Which type of validation occurs in the browser before a request is sent to the server?", "Client-side validation"],
        ["Why is server-side validation still necessary if client-side validation exists?", "Client-side validation can be bypassed"],
        ["A school requires every student to have a unique Student Number. Which rule best represents this requirement?", "Student Number should be unique"],
        ["Which is the best reason for having a database-level unique constraint on StudentNumber?", "It protects data integrity even if application-level validation is bypassed"],
        ["What is the purpose of a try...catch block in a controller?", "To catch and handle exceptions that may occur during execution"],
        ["Which middleware is commonly used in ASP.NET Core for centralized exception handling?", "UseExceptionHandler()"],
        ["A user requests /Student/999, but Student 999 does not exist. What is the most appropriate response?", "Display a Not Found (404) response/page"],
        ["A student already belongs to Section A for a subject. The app tries to assign them to Section A again. What is the primary concern?", "Data integrity"]
    ];

    let idx = 0, flipped = false;
    const stage = document.getElementById('stage');
    const counter = document.getElementById('counter');
    const backColors = ["#1c2c52", "#233866", "#2a4479"];

    function render() {
        stage.innerHTML = '';
        for (let d = 3; d >= 0; d--) {
            const i = (idx + d) % data.length;
            const isFront = d === 0;
            const wrap = document.createElement('div');
            wrap.style.cssText = `position:absolute; inset:0; transform:translateY(${d * 14}px) scale(${1 - d * 0.045}); z-index:${10 - d}; transition:transform .35s;`;

            if (isFront) {
                wrap.style.perspective = '1400px';
                wrap.innerHTML = `
                        <div id="flipInner" style="position:relative; width:100%; height:100%; transform-style:preserve-3d; transition:transform .55s; cursor:pointer;">
                            <div class="stack-card" style="background:linear-gradient(150deg,#3552a6,#25316b); color:#f2f4fb; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:40px; box-sizing:border-box; text-align:center; backface-visibility:hidden; border:1px solid rgba(255,255,255,0.1);">
                                <div style="position:absolute; top:20px; left:24px; font-size:12px; font-weight:600; letter-spacing:.03em; opacity:.75;">QUESTION</div>
                                <div style="font-size:22px; line-height:1.6; font-weight:500;">${data[i][0]}</div>
                                <div style="position:absolute; bottom:20px; font-size:12px; opacity:.6;">Tap to reveal answer</div>
                            </div>
                            <div class="stack-card" style="background:linear-gradient(150deg,#12897c,#0c6058); color:#f2f4fb; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:40px; box-sizing:border-box; text-align:center; backface-visibility:hidden; transform:rotateY(180deg); border:1px solid rgba(255,255,255,0.1);">
                                <div style="position:absolute; top:20px; left:24px; font-size:12px; font-weight:600; letter-spacing:.03em; opacity:.75;">ANSWER</div>
                                <div style="font-size:24px; font-weight:600; line-height:1.5;">${data[i][1]}</div>
                            </div>
                        </div>`;
                wrap.querySelector('#flipInner').addEventListener('click', doFlip);
            } else {
                wrap.innerHTML = `<div class="stack-card" style="background:${backColors[d - 1]}; opacity:${0.75 - d * 0.1}; border:1px solid rgba(255,255,255,0.08);"></div>`;
            }
            stage.appendChild(wrap);
        }
        counter.textContent = `${idx + 1} / ${data.length}`;
    }

    function doFlip() {
        flipped = !flipped;
        document.getElementById('flipInner').style.transform = flipped ? 'rotateY(180deg)' : 'rotateY(0deg)';
    }

    document.getElementById('flipBtn').addEventListener('click', doFlip);
    document.getElementById('nextBtn').addEventListener('click', () => { idx = (idx + 1) % data.length; flipped = false; render(); });
    document.getElementById('prevBtn').addEventListener('click', () => { idx = (idx - 1 + data.length) % data.length; flipped = false; render(); });
    render();
</script>