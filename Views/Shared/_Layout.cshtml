<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT_ELECTIVE_2_BSIT31E1_PREFINAL_EXAM_ROQUE_KEVIN_CLERCK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IT_ELECTIVE_2_BSIT31E1_PREFINAL_EXAM_ROQUE_KEVIN_CLERCK.styles.css" asp-append-version="true" />
    <style>
            html, body {
                background-color: #0f1b33;
                margin: 0;
                min-height: 100%;
            }

            .navbar {
                background-color: #16223f !important;
                border-bottom: 1px solid rgba(255,255,255,0.1) !important;
                box-shadow: none !important;
            }

            .navbar-brand {
                color: #eef1f8 !important;
            }

            .nav-link,
            .nav-link.text-dark {
                color: #cfd7ec !important;
            }

                .nav-link:hover {
                    color: #ffffff !important;
                }

            .navbar-toggler-icon {
                filter: invert(1);
            }

            footer.footer {
                background-color: #0f1b33;
                border-top: 1px solid rgba(255,255,255,0.1) !important;
            }

                footer.footer,
                footer.footer a {
                    color: #9aa5c4 !important;
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">IT_ELECTIVE_2_BSIT31E1_PREFINAL_EXAM_ROQUE_KEVIN_CLERCK</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - IT_ELECTIVE_2_BSIT31E1_PREFINAL_EXAM_ROQUE_KEVIN_CLERCK - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>